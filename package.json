{
  "name": "dulces-raices-mockup",
  "version": "0.1.0",
  "description": "Mockup de catálogo para Dulces Raíces — tienda artesanal naturista de Pasto, Nariño.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,css,json,md}\"",
    "check": "npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/mulish": "^5.3.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "vite": "^8.3.0",
    "vite-plugin-handlebars": "^2.0.3",
    "vitest": "^5.0.0"
  }
}
